{
  "name": "pr-coverage",
  "version": "1.0.1",
  "description": "CLI that measures coverage of changed lines in pull requests using Vitest reports",
  "license": "ISC",
  "author": "",
  "type": "module",
  "bin": {
    "pr-coverage": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "vitest",
    "coverage",
    "pull-request",
    "cli"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "vitest": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
